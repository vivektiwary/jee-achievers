{
  "name": "jeepinnacle",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "test": "node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
